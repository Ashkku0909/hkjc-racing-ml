# ==========================================
# HKJC Racing ML Pipeline - Environment Setup
# ==========================================
# Copy this file to .env and fill in your own values.

# --- Discord Bot ---
# Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# --- Pre-Race Alert Daemon ---
# Channel where prime-value alerts are posted (right-click a channel -> Copy ID)
DISCORD_ALERT_CHANNEL_ID=
# Optional alert ping: "here" for @here, a role ID for @role, or leave empty
DISCORD_ALERT_PING=

# --- PostgreSQL Database ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:your_password@127.0.0.1:5432/hkjc_db

# --- Google Cloud (Optional - for Vertex AI) ---
# Only needed if using Google Cloud services
# GOOGLE_APPLICATION_CREDENTIALS=path/to/your-service-account.json

# --- Proxy Settings (Optional) ---
# Uncomment if behind a proxy/VPN
# http_proxy=http://127.0.0.1:7890
# https_proxy=http://127.0.0.1:7890
# no_proxy=localhost,127.0.0.1,::1
